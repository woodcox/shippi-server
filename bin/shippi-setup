#!/usr/bin/env bash
set -euo pipefail

MARKER="$HOME/.shippi-setup-done"

if [ -f "$MARKER" ]; then
  exec /bin/bash -l "$@"
fi

local CYAN=$'\e[36m'
local RESET=$'\e[0m'
local -a art=(
    '                  ┏━┓ ╻ ╻ ╻ ┏━┓ ┏━┓ ╻'
    '                  ┗━┓ ┣━┫ ┃ ┣━┛ ┣━┛ ┃'
    '                  ┗━┛ ╹ ╹ ╹ ╹   ╹   ╹'
    '                    ─ s e r v e r ─'
    '                                   ▀▀▀       ▀▀▀'
    '          ·                       ╱         ╱'
    '   ·            *             ███▓███   ███▓███'
    '       *     *               ███▓███   ███▓███'
    '  .  ▄▄▄▄        . █           ╱      ███▓███      ▀▀▀'
    ' ▄▄▄▄▄▄▄▄▄▄▄   *   ███     ███▓███      ╱         ╱'
    '▒▒▒▒▒    ▀▀▀▀▀     ███    ███▓███   ███▓███   ███▓███'
    '▒▒▒▒▒░░░░  ▀▀▀▀▀ . ██████   ╱      ███▓███   ███▓███'
    '▒▒▒▒▒▒▒▒▒░░░░      ███ ██████     ███▓███      ╱'
    '▓▓▓▓▓▓▓▒▒▒▒▒▒░░░░    █████ ██████   ╱      ███▓███'
    '▓▓▓▓▓▓▓▓▓▓▒▒▒▒▒▒▒░░░░    █████ ██████     ███▓███'
    '▓▓▓▓▓▓▓▓▓▓▓▓▓▒▒▒▒▒▒▒▒░░░░    █████ ██████   ╱'
    '▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▒▒▒▒▒▒▒▒░░░░    █████ ██████        ▀▀▀'
    '█████████▓▓▓▓▓▓▓▓▓▓▓▓▒▒▒▒▒▒▒▒░░░░    █████ ██████  ███▀'
    '█████████████▓▓▓▓▓▓▓▓▓▓▓▓▒▒▒▒▒▒▒▒░░░░    █████ █████▀ .'
    '█████████████████▓▓▓▓▓▓▓▓▓▓▓▓▒▒▒▒▒▒▒▒░░░░    ████▀ .     *'
)

printf '\n%s' "$CYAN"
printf '%s\n' "${art[@]}"
printf '%s\n\n' "$RESET"
echo "Welcome to Shippi-server 🚀, let's get you set up."
echo

# Git identity
if ! git config --global user.name &>/dev/null || ! git config --global user.email &>/dev/null; then
  if gum confirm "Identify for Git?"; then
    source ~/.config/shell/functions
    git-id || true
  fi
fi

# GitHub CLI
if ! gh auth status &>/dev/null; then
  echo
  if gum confirm "Authenticate with GitHub?"; then
    gh auth login
  fi
fi

# Tailscale
if command -v tailscale &>/dev/null && ! tailscale status &>/dev/null; then
  echo
  if gum confirm "Connect to Tailscale?"; then
    sudo systemctl enable --now tailscaled.service
    sudo tailscale up --ssh --accept-routes
  fi
fi

echo
echo "✓ Setup complete!"
touch "$MARKER"
exec /bin/bash -l "$@"
