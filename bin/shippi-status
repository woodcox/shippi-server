#!/usr/bin/env bash
#
# shippi status
#
# Capacity details that do not belong in a hardening audit: inode use,
# journal size against its cap, reclaimable apt cache, and Docker space.
# Read-only. For the hardening checks, run `shippi-harden --audit`.

set -euo pipefail

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Reuse the audit's primitives: peek, section, have, docker_present. The guard
# lets the test suite source both files without re-running shippi-harden's
# top-level setup and without overwriting its main().
if ! declare -F docker_present >/dev/null 2>&1; then
  if [[ ! -r $SELF_DIR/shippi-harden ]]; then
    printf 'error: shippi-harden not found beside %s\n' "$0" >&2
    exit 1
  fi
  # shellcheck source=shippi-harden
  source "$SELF_DIR/shippi-harden"
fi

# Counts for humans: 715529 -> 716k, 30313024 -> 30.3M.
human_count() {
  awk -v n="$1" 'BEGIN {
    if (n >= 1000000000) printf "%.1fB", n / 1000000000
    else if (n >= 1000000) printf "%.1fM", n / 1000000
    else if (n >= 1000) printf "%.0fk", n / 1000
    else printf "%d", n
  }'
}

inode_summary() {
  local row total used pcent
  row="$(LC_ALL=C df --output=itotal,iused,ipcent -- / 2>/dev/null | tail -1 || true)"
  read -r total used pcent <<<"$row"
  if [[ ! $total =~ ^[0-9]+$ || ! $used =~ ^[0-9]+$ || ! $pcent =~ ^[0-9]+%$ ]]; then
    printf 'unavailable\n'
    return 0
  fi
  printf '/  %s used (%s of %s)\n' \
    "$pcent" "$(human_count "$used")" "$(human_count "$total")"
}

# Journald sizes are printed as 139.6M, 1.2G, ... Convert to KiB so the
# percentage against the cap is computed in one unit.
size_to_kb() {
  awk -v s="$1" 'BEGIN {
    if (s !~ /^[0-9.]+[KMGTP]?$/) exit 1
    unit = substr(s, length(s), 1)
    n = s
    if (unit ~ /[KMGTP]/) sub(/[KMGTP]$/, "", n)
    mult = 1
    if (unit == "M") mult = 1024
    else if (unit == "G") mult = 1048576
    else if (unit == "T") mult = 1073741824
    else if (unit == "P") mult = 1099511627776
    printf "%d", n * mult
  }'
}

# cat-config merges the main file and every drop-in in precedence order, so
# the last uncommented assignment is the effective one. `systemctl show` does
# not expose these settings.
journal_max_use() {
  local key="${1:-SystemMaxUse}"
  systemd-analyze cat-config systemd/journald.conf 2>/dev/null |
    sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" |
    sed 's/[[:space:]]*$//' |
    tail -1
}

# Usage of one journal storage directory in human units, or empty when it
# cannot be read. A specific directory keeps the persistent and volatile
# totals separate so each can use its own cap.
journal_usage() {
  local dir="$1"
  peek journalctl --directory="$dir" --disk-usage 2>/dev/null |
    sed -n 's/.*take up \([0-9.]\+[KMGTP]\?\).*/\1/p' | tail -1 || true
}

journal_cap_usage() {
  local used="$1" cap="$2" used_kb cap_kb pct
  if [[ -z $cap ]]; then
    printf '%s (no explicit cap)' "$used"
    return 0
  fi
  used_kb="$(size_to_kb "$used" || true)"
  # journald.conf accepts a bare byte count. journalctl always prints a unit
  # for usage, so only the cap needs the byte path.
  if [[ $cap =~ ^[0-9]+$ ]]; then
    cap_kb=$((10#$cap / 1024))
  else
    cap_kb="$(size_to_kb "$cap" || true)"
  fi
  if [[ $used_kb =~ ^[0-9]+$ && $cap_kb =~ ^[0-9]+$ ]] && ((cap_kb > 0)); then
    pct=$(((used_kb * 100 + cap_kb / 2) / cap_kb))
    printf '%s of %s cap (%s%%)' "$used" "$cap" "$pct"
  else
    printf '%s (cap %s)' "$used" "$cap"
  fi
}

journal_summary() {
  local persistent runtime p_kb r_kb
  local -a parts=()
  persistent="$(journal_usage /var/log/journal)"
  runtime="$(journal_usage /run/log/journal)"
  p_kb="$(size_to_kb "$persistent" 2>/dev/null || true)"
  r_kb="$(size_to_kb "$runtime" 2>/dev/null || true)"

  # A zero or empty storage has no journal files; do not print a 0B line.
  if [[ $p_kb =~ ^[0-9]+$ ]] && ((p_kb > 0)); then
    parts+=("persistent $(journal_cap_usage "$persistent" "$(journal_max_use SystemMaxUse || true)")")
  fi
  if [[ $r_kb =~ ^[0-9]+$ ]] && ((r_kb > 0)); then
    parts+=("runtime $(journal_cap_usage "$runtime" "$(journal_max_use RuntimeMaxUse || true)")")
  fi

  if ((${#parts[@]} == 0)); then
    if [[ -z $persistent && -z $runtime ]]; then
      printf 'unavailable\n'
    else
      printf 'no journal files\n'
    fi
    return 0
  fi
  local joined="" part
  for part in "${parts[@]}"; do
    joined+="${joined:+; }$part"
  done
  printf '%s\n' "$joined"
}

apt_cache_summary() {
  local dir="${SHIPPI_APT_CACHE_DIR:-/var/cache/apt/archives}" size
  if [[ ! -d $dir ]]; then
    printf 'none\n'
    return 0
  fi
  # du can print a partial total and still exit non-zero, for example when it
  # cannot read one entry. Accept the size only when the whole run succeeded.
  if ! size="$(peek du -sh "$dir" 2>/dev/null | cut -f1)"; then
    printf 'unavailable\n'
    return 0
  fi
  if [[ -z $size ]]; then
    printf 'unavailable\n'
  else
    printf '%s reclaimable\n' "$size"
  fi
}

# `docker system df` sizes are logical and count shared layers per image, so
# they can be several times the blocks the directory occupies. Both numbers
# are useful, for different questions, hence both on the line.
docker_disk_summary() {
  if ! docker_present; then
    printf 'not running\n'
    return 0
  fi

  local root on_disk images="" summary
  # The docker group is root-equivalent, so a hardened box may run as a sudo
  # user who cannot read the socket. Query directly first and elevate only
  # when that fails, so a user already in the docker group is not prompted.
  root="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null ||
    peek docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)"
  [[ -n $root ]] || root=/var/lib/docker
  on_disk="$(peek du -sh "$root" 2>/dev/null | cut -f1 || true)"
  [[ -n $on_disk ]] || on_disk="on-disk size unavailable (needs root)"

  if summary="$(docker system df --format '{{.Type}}\t{{.Size}}\t{{.Reclaimable}}' 2>/dev/null ||
    peek docker system df --format '{{.Type}}\t{{.Size}}\t{{.Reclaimable}}' 2>/dev/null)"; then
    images="$(printf '%s\n' "$summary" | awk -F'\t' '
      $1 == "Images" {
        reclaim = $3
        sub(/ *\([^)]*\)[[:space:]]*$/, "", reclaim)
        printf "%s logical images (%s reclaimable)", $2, reclaim
        found = 1
        exit
      }
      END { if (!found) exit 1 }
    ')" || images=""
  fi

  if [[ -n $images ]]; then
    printf '%s on disk, %s\n' "$on_disk" "$images"
  else
    printf '%s on disk, logical usage unavailable\n' "$on_disk"
  fi
}

status_report() {
  section "Storage details"
  printf '  %-14s %s\n' inodes "$(inode_summary)"
  printf '  %-14s %s\n' journal "$(journal_summary)"
  printf '  %-14s %s\n' "apt cache" "$(apt_cache_summary)"
  printf '  %-14s %s\n' docker "$(docker_disk_summary)"
}

status_usage() {
  cat <<'EOF'
shippi storage details
Usage: shippi-status

Read-only capacity details: inode use, journal size against its cap,
reclaimable apt cache, and Docker space.

For hardening checks, run: shippi-harden --audit
EOF
}

status_main() {
  case "${1:-}" in
    -h | --help) status_usage; return 0 ;;
    "") ;;
    *)
      printf 'unknown option: %s\n\n' "$1" >&2
      status_usage >&2
      return 2
      ;;
  esac

  # Cache sudo once so the journal and Docker reads do not prompt separately.
  # Without it the report still runs; those lines report unavailable.
  if [[ $(id -u) -ne 0 ]] && have sudo && ! sudo -n true &>/dev/null && have_tty; then
    step "asking for sudo once, everything after this is cached"
    sudo -v || true
  fi

  status_report
}

# Sourcing this file gives you the helpers and runs nothing, which is what the
# tests do.
if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then
  status_main "$@"
fi
